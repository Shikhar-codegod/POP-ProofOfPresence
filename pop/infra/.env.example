# -----------------------------------------------------------------------------
# ProofOfPresence (POP) - Environment Configuration
# -----------------------------------------------------------------------------

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & Authentication (Generate secure keys with `openssl rand -hex 32`)
SECRET_KEY=dev_secret_key_change_in_production_894f28a9b31d4e78
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# PostgreSQL Database Configuration
POSTGRES_USER=pop_user
POSTGRES_PASSWORD=pop_password
POSTGRES_DB=pop_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy Async Database URL (used inside Docker)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://pop_user:pop_password@postgres:5432/pop_db

# Sync Database URL for Alembic Migrations
DATABASE_SYNC_URL=postgresql+psycopg2://pop_user:pop_password@postgres:5432/pop_db

# Redis Cache & Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Edge Ingestion Settings
MAX_FUTURE_TIMESTAMP_SKEW_SECONDS=300
DEFAULT_ROLLING_WINDOW_K=5
